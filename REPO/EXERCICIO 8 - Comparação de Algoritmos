#include <stdio.h>

#define MAX 100

int buscaLinear(int v[], int n, int chave, int *comparacoes) {
    int i;
    *comparacoes = 0;
    for (i = 0; i < n; i++) {
        (*comparacoes)++;
        if (v[i] == chave) {
            return i;
        }
    }
    return -1;
}

int buscaBinaria(int v[], int n, int chave, int *comparacoes) {
    int inicio = 0;
    int fim = n - 1;
    int meio;

    *comparacoes = 0;
    while (inicio <= fim) {
        meio = (inicio + fim) / 2;
        (*comparacoes)++;

        if (v[meio] == chave) {
            return meio;
        } else if (v[meio] < chave) {
            inicio = meio + 1;
        } else {
            fim = meio - 1;
        }
    }
    return -1;
}

int main() {
    int v[MAX];
    int n, i, chave;
    int posL, posB, compL, compB;

    printf("Quantos elementos tem o vetor? ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX) {
        printf("Quantidade invalida!\n");
        return 1;
    }

    printf("Digite os %d valores JA EM ORDEM CRESCENTE:\n", n);
    for (i = 0; i < n; i++) {
        printf("v[%d] = ", i);
        scanf("%d", &v[i]);
    }

    printf("Valor a procurar: ");
    scanf("%d", &chave);

    posL = buscaLinear(v, n, chave, &compL);
    posB = buscaBinaria(v, n, chave, &compB);

    printf("\n--- RESULTADO ---\n");
    if (posL == -1) {
        printf("Busca Linear : nao encontrado  | comparacoes = %d\n", compL);
    } else {
        printf("Busca Linear : achado em v[%d] | comparacoes = %d\n", posL, compL);
    }

    if (posB == -1) {
        printf("Busca Binaria: nao encontrado  | comparacoes = %d\n", compB);
    } else {
        printf("Busca Binaria: achado em v[%d] | comparacoes = %d\n", posB, compB);
    }

    printf("\nBusca Linear  -> O(n)\n");
    printf("Busca Binaria -> O(log n)\n");
}
