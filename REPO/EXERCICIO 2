#include <stdio.h>

#define MAX 100

typedef struct {
    int codigo;
    char nome[50];
    float preco;
    int quantidade;
} Produto;

int main() {
    Produto estoque[MAX];
    int total = 0;
    int opcao, i, chave, achou;
    float valorTotal;

    do {
        printf("\n===== SISTEMA DE PRODUTOS =====\n");
        printf("1 - Cadastrar produto\n");
        printf("2 - Exibir todos os produtos\n");
        printf("3 - Buscar produto pelo codigo\n");
        printf("4 - Calcular valor total do estoque\n");
        printf("0 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total >= MAX) {
                printf("Estoque cheio!\n");
            } else {
                printf("Codigo: ");
                scanf("%d", &estoque[total].codigo);
                printf("Nome: ");
                scanf(" %49[^\n]", estoque[total].nome);
                printf("Preco: ");
                scanf("%f", &estoque[total].preco);
                printf("Quantidade: ");
                scanf("%d", &estoque[total].quantidade);
                total++;
                printf("Produto cadastrado com sucesso!\n");
            }
        }
        else if (opcao == 2) {
            if (total == 0) {
                printf("Nenhum produto cadastrado.\n");
            } else {
                printf("\n--- PRODUTOS ---\n");
                for (i = 0; i < total; i++) {
                    printf("Codigo: %d | Nome: %s | Preco: R$ %.2f | Qtd: %d | Subtotal: R$ %.2f\n",
                           estoque[i].codigo, estoque[i].nome, estoque[i].preco,
                           estoque[i].quantidade,
                           estoque[i].preco * estoque[i].quantidade);
                }
            }
        }
        else if (opcao == 3) {
            printf("Digite o codigo: ");
            scanf("%d", &chave);
            achou = 0;
            for (i = 0; i < total; i++) {
                if (estoque[i].codigo == chave) {
                    printf("Encontrado -> Nome: %s | Preco: R$ %.2f | Qtd: %d\n",
                           estoque[i].nome, estoque[i].preco, estoque[i].quantidade);
                    achou = 1;
                }
            }
            if (achou == 0) {
                printf("Codigo nao encontrado.\n");
            }
        }
        else if (opcao == 4) {
            valorTotal = 0;
            for (i = 0; i < total; i++) {
                valorTotal += estoque[i].preco * estoque[i].quantidade;
            }
            printf("Valor total do estoque = R$ %.2f\n", valorTotal);
        }
        else if (opcao != 0) {
            printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    printf("Programa encerrado.\n");
}
