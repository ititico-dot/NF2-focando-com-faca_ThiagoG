//reciclado do exercicio anterior (o 14)

#include <stdio.h>
#include <stdlib.h>

typedef struct No {
    int valor;
    struct No *prox;
} No;

No *inicio = NULL;

void inserirFim(int valor) {
    No *novo = malloc(sizeof(No));
    novo->valor = valor;
    novo->prox = NULL;

    if (inicio == NULL) {
        inicio = novo;
    } else {
        No *aux = inicio;
        while (aux->prox != NULL) {
            aux = aux->prox;
        }
        aux->prox = novo;
    }
}


void listar() {
    No *aux = inicio;
    while (aux != NULL) {
        printf("%d -> ", aux->valor);
        aux = aux->prox;
    }
    printf("NULL\n");
}

int main() {

    inserirFim(5);
    inserirFim(10);
    inserirFim(15);
    printf("--- LISTA ---\n");
    listar();

}





