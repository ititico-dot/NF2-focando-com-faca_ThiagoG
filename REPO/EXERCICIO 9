#include <stdio.h>

#define MAX 100

int maior(int v[], int n) {
    int i;
    int m = v[0];
    for (i = 1; i < n; i++) {
        if (v[i] > m) {
            m = v[i];
        }
    }
    return m;
}

int main() {
    int v[MAX];
    int n, i;

    printf("Quantos numeros? ");
    scanf("%d", &n);

    if (n <= 0 || n > MAX) {
        printf("Quantidade invalida!\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("v[%d] = ", i);
        scanf("%d", &v[i]);
    }

    printf("O maior valor do vetor e = %d\n", maior(v, n));

}
