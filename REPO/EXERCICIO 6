#include <stdio.h>
#include <string.h>

#define MAX 100

typedef struct {
    char nome[50];
    char telefone[20];
    char email[50];
} Contato;

int main() {
    Contato agenda[MAX];
    Contato temp;
    int total = 0;
    int opcao, i, j, achou, pos;
    char busca[50];

    do {
        printf("\n===== AGENDA DE CONTATOS =====\n");
        printf("1 - Cadastrar contato\n");
        printf("2 - Listar contatos\n");
        printf("3 - Buscar por nome\n");
        printf("4 - Ordenar em ordem alfabetica\n");
        printf("5 - Remover contato\n");
        printf("0 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total >= MAX) {
                printf("Agenda cheia!\n");
            } else {
                printf("Nome: ");
                scanf(" %49[^\n]", agenda[total].nome);
                printf("Telefone: ");
                scanf(" %19[^\n]", agenda[total].telefone);
                printf("Email: ");
                scanf(" %49[^\n]", agenda[total].email);
                total++;
                printf("Contato cadastrado!\n");
            }
        }
        else if (opcao == 2) {
            if (total == 0) {
                printf("Agenda vazia.\n");
            } else {
                printf("\n--- CONTATOS ---\n");
                for (i = 0; i < total; i++) {
                    printf("%d) Nome: %s | Tel: %s | Email: %s\n",
                           i + 1, agenda[i].nome, agenda[i].telefone, agenda[i].email);
                }
            }
        }
        else if (opcao == 3) {
            printf("Nome a buscar: ");
            scanf(" %49[^\n]", busca);
            achou = 0;
            for (i = 0; i < total; i++) {
                if (strcmp(agenda[i].nome, busca) == 0) {
                    printf("Encontrado -> Nome: %s | Tel: %s | Email: %s\n",
                           agenda[i].nome, agenda[i].telefone, agenda[i].email);
                    achou = 1;
                }
            }
            if (achou == 0) {
                printf("Contato nao encontrado.\n");
            }
        }
        else if (opcao == 4) {
            for (i = 0; i < total - 1; i++) {
                for (j = 0; j < total - 1 - i; j++) {
                    if (strcmp(agenda[j].nome, agenda[j + 1].nome) > 0) {
                        temp = agenda[j];
                        agenda[j] = agenda[j + 1];
                        agenda[j + 1] = temp;
                    }
                }
            }
            printf("Agenda ordenada em ordem alfabetica!\n");
        }
        else if (opcao == 5) {
            printf("Nome a remover: ");
            scanf(" %49[^\n]", busca);
            pos = -1;
            for (i = 0; i < total; i++) {
                if (strcmp(agenda[i].nome, busca) == 0) {
                    pos = i;
                    break;
                }
            }
            if (pos == -1) {
                printf("Contato nao encontrado.\n");
            } else {
                for (i = pos; i < total - 1; i++) {
                    agenda[i] = agenda[i + 1];   /* desloca para tras */
                }
                total--;
                printf("Contato removido!\n");
            }
        }
        else if (opcao != 0) {
            printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    printf("Programa encerrado.\n");
}
