#include <stdio.h>

#define MAX 100

typedef struct {
    int matricula;
    char nome[50];
    int idade;
    float nota;
} Aluno;

int main() {
    Aluno turma[MAX];
    int total = 0;
    int opcao, i, chave, achou, indiceMaior;

    do {
        printf("\n===== CADASTRO DE ALUNOS =====\n");
        printf("1 - Cadastrar aluno\n");
        printf("2 - Listar todos os alunos\n");
        printf("3 - Buscar aluno pela matricula\n");
        printf("4 - Mostrar aluno com maior nota\n");
        printf("0 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total >= MAX) {
                printf("Cadastro cheio!\n");
            } else {
                printf("Matricula: ");
                scanf("%d", &turma[total].matricula);
                printf("Nome: ");
                scanf(" %49[^\n]", turma[total].nome);
                printf("Idade: ");
                scanf("%d", &turma[total].idade);
                printf("Nota final: ");
                scanf("%f", &turma[total].nota);
                total++;
                printf("Aluno cadastrado com sucesso!\n");
            }
        }
        else if (opcao == 2) {
            if (total == 0) {
                printf("Nenhum aluno cadastrado.\n");
            } else {
                printf("\n--- LISTA DE ALUNOS ---\n");
                for (i = 0; i < total; i++) {
                    printf("Matricula: %d | Nome: %s | Idade: %d | Nota: %.2f\n",
                           turma[i].matricula, turma[i].nome,
                           turma[i].idade, turma[i].nota);
                }
            }
        }
        else if (opcao == 3) {
            printf("Digite a matricula: ");
            scanf("%d", &chave);
            achou = 0;
            for (i = 0; i < total; i++) {
                if (turma[i].matricula == chave) {
                    printf("Encontrado -> Nome: %s | Idade: %d | Nota: %.2f\n",
                           turma[i].nome, turma[i].idade, turma[i].nota);
                    achou = 1;
                }
            }
            if (achou == 0) {
                printf("Matricula nao encontrada.\n");
            }
        }
        else if (opcao == 4) {
            if (total == 0) {
                printf("Nenhum aluno cadastrado.\n");
            } else {
                indiceMaior = 0;
                for (i = 1; i < total; i++) {
                    if (turma[i].nota > turma[indiceMaior].nota) {
                        indiceMaior = i;
                    }
                }
                printf("Maior nota -> %s (matricula %d) com %.2f\n",
                       turma[indiceMaior].nome,
                       turma[indiceMaior].matricula,
                       turma[indiceMaior].nota);
            }
        }
        else if (opcao != 0) {
            printf("Opcao invalida!\n");
        }

    } while (opcao != 0);

    printf("Programa encerrado.\n");
    return 0;
}
